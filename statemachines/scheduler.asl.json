{
  "Comment": "Night stop / morning start of the app ASGs, in a safe order. Started by EventBridge Scheduler with {\"action\": \"stop\"|\"start\"}. Rendered by Terraform templatefile().",
  "QueryLanguage": "JSONata",
  "StartAt": "Action",
  "States": {
    "Action": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $states.input.action = 'stop' %}",
          "Next": "DisableFailoverRule"
        },
        {
          "Condition": "{% $states.input.action = 'start' %}",
          "Next": "ScaleUpPrimary"
        }
      ],
      "Default": "UnknownAction"
    },
    "UnknownAction": {
      "Type": "Fail",
      "Error": "UnknownAction",
      "Cause": "Input must be {\"action\": \"stop\"} or {\"action\": \"start\"}."
    },
    "DisableFailoverRule": {
      "Type": "Task",
      "Comment": "FIRST: otherwise scaling to 0 fires the alarm and the failover would scale the standby back up.",
      "Resource": "arn:aws:states:::aws-sdk:eventbridge:disableRule",
      "Arguments": {
        "Name": "${event_rule_name}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "MuteAlarm"
    },
    "MuteAlarm": {
      "Type": "Task",
      "Comment": "No ALARM emails for a planned stop.",
      "Resource": "arn:aws:states:::aws-sdk:cloudwatch:disableAlarmActions",
      "Arguments": {
        "AlarmNames": [
          "${alarm_name}"
        ]
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "ScaleDownPrimary"
    },
    "ScaleDownPrimary": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:autoscaling:setDesiredCapacity",
      "Arguments": {
        "AutoScalingGroupName": "${asg_a_name}",
        "DesiredCapacity": 0,
        "HonorCooldown": false
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "ScaleDownStandby"
    },
    "ScaleDownStandby": {
      "Type": "Task",
      "Comment": "Also the standby, in case the app is failed over to it.",
      "Resource": "arn:aws:states:::aws-sdk:autoscaling:setDesiredCapacity",
      "Arguments": {
        "AutoScalingGroupName": "${asg_b_name}",
        "DesiredCapacity": 0,
        "HonorCooldown": false
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Stopped"
    },
    "Stopped": {
      "Type": "Succeed"
    },
    "ScaleUpPrimary": {
      "Type": "Task",
      "Comment": "Mornings always start on the primary AZ (ASG-a).",
      "Resource": "arn:aws:states:::aws-sdk:autoscaling:setDesiredCapacity",
      "Arguments": {
        "AutoScalingGroupName": "${asg_a_name}",
        "DesiredCapacity": 1,
        "HonorCooldown": false
      },
      "Assign": {
        "polls": 0,
        "healthy_streak": 0
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "WaitBeforeCheck"
    },
    "WaitBeforeCheck": {
      "Type": "Wait",
      "Seconds": 60,
      "Next": "GetTargetHealth"
    },
    "GetTargetHealth": {
      "Type": "Task",
      "Comment": "Count consecutive minutes with a healthy target. NLB metrics arrive ~5 min late, so a fresh 'OK' alarm can be stale.",
      "Resource": "arn:aws:states:::aws-sdk:elasticloadbalancingv2:describeTargetHealth",
      "Arguments": {
        "TargetGroupArn": "${target_group_arn}"
      },
      "Assign": {
        "polls": "{% $polls + 1 %}",
        "healthy_streak": "{% $count($states.result.TargetHealthDescriptions[TargetHealth.State = 'healthy']) > 0 ? $healthy_streak + 1 : 0 %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "GetAlarmState"
    },
    "GetAlarmState": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:cloudwatch:describeAlarms",
      "Arguments": {
        "AlarmNames": [
          "${alarm_name}"
        ]
      },
      "Output": "{% {'alarm': $states.result.MetricAlarms[0].StateValue, 'healthy_streak': $healthy_streak, 'polls': $polls} %}",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "SafeToRearm"
    },
    "SafeToRearm": {
      "Type": "Choice",
      "Comment": "Re-arm only after the target was healthy for ${rearm_after_minutes} straight minutes AND the alarm is OK; give up waiting after ${max_polls} minutes so the guard is never left off.",
      "Choices": [
        {
          "Condition": "{% ($healthy_streak >= ${rearm_after_minutes} and $states.input.alarm = 'OK') or $polls >= ${max_polls} %}",
          "Next": "EnableFailoverRule"
        }
      ],
      "Default": "WaitBeforeCheck"
    },
    "EnableFailoverRule": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:eventbridge:enableRule",
      "Arguments": {
        "Name": "${event_rule_name}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "UnmuteAlarm"
    },
    "UnmuteAlarm": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:cloudwatch:enableAlarmActions",
      "Arguments": {
        "AlarmNames": [
          "${alarm_name}"
        ]
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Started"
    },
    "Started": {
      "Type": "Succeed"
    }
  }
}
