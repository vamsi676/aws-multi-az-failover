{
  "Comment": "Taskboard failover: move traffic from the active ASG/AZ to the standby ASG/AZ. Rendered by Terraform templatefile().",
  "QueryLanguage": "JSONata",
  "StartAt": "Init",
  "States": {
    "Init": {
      "Type": "Pass",
      "Comment": "Defaults come from Terraform; a manual start may pass {\"overrides\": {...}} (used by the failure-path test).",
      "Assign": {
        "cfg": "{% $merge([{'source_asg': '${source_asg}', 'target_asg': '${target_asg}', 'source_az': '${source_az}', 'target_az': '${target_az}'}, $exists($states.input.overrides) ? $states.input.overrides : {}]) %}",
        "trigger": "{% $exists($states.input.detail.alarmName) ? ('CloudWatch alarm ' & $states.input.detail.alarmName) : 'Manual start' %}",
        "alarm_time": "{% $exists($states.input.time) ? $states.input.time : '' %}",
        "started_at": "{% $states.context.Execution.StartTime %}",
        "checks": 0,
        "t_precheck": "",
        "t_scale_up": "",
        "t_last_check": "",
        "t_scale_down": "",
        "last_check": {},
        "precheck": {},
        "failed_state": "",
        "error": {},
        "ai_report": "",
        "ai_analysis": ""
      },
      "Next": "Precheck"
    },
    "Precheck": {
      "Type": "Task",
      "Comment": "Split-brain, concurrent-execution and deployment guards.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${precheck_arn}",
        "Payload": {
          "state_machine_arn": "{% $states.context.StateMachine.Id %}",
          "execution_arn": "{% $states.context.Execution.Id %}",
          "standby_asg": "{% $cfg.target_asg %}",
          "codedeploy_app": "${codedeploy_app}",
          "deployment_group": "${deployment_group}"
        }
      },
      "Assign": {
        "precheck": "{% $states.result.Payload %}",
        "t_precheck": "{% $states.context.State.EnteredTime %}"
      },
      "Output": "{% $states.result.Payload %}",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Assign": {
            "error": "{% $states.errorOutput %}",
            "failed_state": "Precheck"
          },
          "Next": "AnalyzeFailure"
        }
      ],
      "Next": "ShouldProceed"
    },
    "ShouldProceed": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $states.input.proceed = true %}",
          "Next": "ScaleUpStandby"
        }
      ],
      "Default": "NotifySkipped"
    },
    "NotifySkipped": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Arguments": {
        "TopicArn": "${sns_topic_arn}",
        "Subject": "[mazf] Failover SKIPPED",
        "Message": "{% $join(['Taskboard failover was SKIPPED. Nothing was scaled.', '', 'Reason: ' & $precheck.reason, '', 'Trigger:   ' & $trigger, 'Alarm time: ' & ($alarm_time = '' ? 'n/a' : $alarm_time), 'Checks:    ' & $string($precheck.checks), '', 'Execution: ' & $states.context.Execution.Id], '\\n') %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Skipped"
    },
    "Skipped": {
      "Type": "Succeed"
    },
    "ScaleUpStandby": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${scale_asg_arn}",
        "Payload": {
          "asg_name": "{% $cfg.target_asg %}",
          "desired": 1
        }
      },
      "Assign": {
        "t_scale_up": "{% $states.context.State.EnteredTime %}"
      },
      "Output": "{% $states.result.Payload %}",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Assign": {
            "error": "{% $states.errorOutput %}",
            "failed_state": "ScaleUpStandby"
          },
          "Next": "AnalyzeFailure"
        }
      ],
      "Next": "WaitForTargets"
    },
    "WaitForTargets": {
      "Type": "Wait",
      "Seconds": 30,
      "Next": "CheckTargets"
    },
    "CheckTargets": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${check_targets_arn}",
        "Payload": {
          "target_group_arn": "${target_group_arn}",
          "asg_name": "{% $cfg.target_asg %}"
        }
      },
      "Assign": {
        "checks": "{% $checks + 1 %}",
        "last_check": "{% $states.result.Payload %}",
        "t_last_check": "{% $states.context.State.EnteredTime %}"
      },
      "Output": "{% $states.result.Payload %}",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Assign": {
            "error": "{% $states.errorOutput %}",
            "failed_state": "CheckTargets"
          },
          "Next": "AnalyzeFailure"
        }
      ],
      "Next": "StandbyHealthy"
    },
    "StandbyHealthy": {
      "Type": "Choice",
      "Comment": "Loop every 30s, at most ${max_checks} checks (about 15 minutes).",
      "Choices": [
        {
          "Condition": "{% $states.input.healthy = true %}",
          "Next": "ScaleDownActive"
        },
        {
          "Condition": "{% $checks >= ${max_checks} %}",
          "Next": "TargetsTimedOut"
        }
      ],
      "Default": "WaitForTargets"
    },
    "TargetsTimedOut": {
      "Type": "Pass",
      "Assign": {
        "error": "{% {'Error': 'StandbyNotHealthy', 'Cause': 'No healthy target in ' & $cfg.target_asg & ' after ' & $string($checks) & ' checks. Last check: ' & $string($last_check)} %}",
        "failed_state": "StandbyHealthy"
      },
      "Next": "AnalyzeFailure"
    },
    "ScaleDownActive": {
      "Type": "Task",
      "Comment": "Only after the standby is healthy: never leave the app with zero instances.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${scale_asg_arn}",
        "Payload": {
          "asg_name": "{% $cfg.source_asg %}",
          "desired": 0
        }
      },
      "Assign": {
        "t_scale_down": "{% $states.context.State.EnteredTime %}"
      },
      "Output": "{% $states.result.Payload %}",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Assign": {
            "error": "{% $states.errorOutput %}",
            "failed_state": "ScaleDownActive"
          },
          "Next": "AnalyzeFailure"
        }
      ],
      "Next": "WriteIncidentReport"
    },
    "WriteIncidentReport": {
      "Type": "Task",
      "Comment": "Bedrock writes a short report. Never on the recovery path: 30 s timeout, own Catch, plain message on any error.",
      "Resource": "arn:aws:states:::bedrock:invokeModel",
      "TimeoutSeconds": 30,
      "Arguments": {
        "ModelId": "${bedrock_model_arn}",
        "ContentType": "application/json",
        "Accept": "application/json",
        "Body": {
          "schemaVersion": "messages-v1",
          "system": [
            {
              "text": ${incident_prompt}
            }
          ],
          "messages": [
            {
              "role": "user",
              "content": [
                {
                  "text": "{% 'Facts (JSON):\\n' & $string({'workflow': 'failover', 'result': 'SUCCEEDED', 'trigger': $trigger, 'alarm_time_utc': $alarm_time, 'execution_started_utc': $started_at, 'precheck_utc': $t_precheck, 'target_scaled_up_utc': $t_scale_up, 'target_healthy_utc': $t_last_check, 'health_checks_needed': $checks, 'source_scaled_down_utc': $t_scale_down, 'source': {'asg': $cfg.source_asg, 'az': $cfg.source_az}, 'target': {'asg': $cfg.target_asg, 'az': $cfg.target_az}, 'execution_duration_seconds': $round(($toMillis($states.context.State.EnteredTime) - $toMillis($started_at)) / 1000, 1), 'alarm_to_recovery_seconds': ($alarm_time = '' ? null : $round(($toMillis($t_last_check) - $toMillis($alarm_time)) / 1000, 1)), 'healthy_targets': $last_check.targets}) %}"
                }
              ]
            }
          ],
          "inferenceConfig": {
            "maxTokens": ${max_tokens},
            "temperature": 0.2
          }
        }
      },
      "Assign": {
        "ai_report": "{% $states.result.Body.output.message.content[0].text %}"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Assign": {
            "ai_report": "{% '(AI incident report unavailable: ' & $states.errorOutput.Error & '. The facts above are complete.)' %}"
          },
          "Next": "NotifySuccess"
        }
      ],
      "Next": "NotifySuccess"
    },
    "NotifySuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Arguments": {
        "TopicArn": "${sns_topic_arn}",
        "Subject": "{% '[mazf] Failover SUCCEEDED: ' & $cfg.source_az & ' -> ' & $cfg.target_az %}",
        "Message": "{% $join(['Taskboard failover SUCCEEDED.', '', 'Traffic moved from ' & $cfg.source_asg & ' (' & $cfg.source_az & ') to ' & $cfg.target_asg & ' (' & $cfg.target_az & ').', '', 'Timeline (UTC):', '  Alarm:               ' & ($alarm_time = '' ? 'n/a (' & $trigger & ')' : $alarm_time), '  Execution started:   ' & $started_at, '  Precheck:            ' & $t_precheck, '  Standby scaled up:   ' & $t_scale_up, '  Standby healthy:     ' & $t_last_check & ' (check #' & $string($checks) & ')', '  Active scaled down:  ' & $t_scale_down, '', 'Execution duration: ' & $string($round(($toMillis($states.context.State.EnteredTime) - $toMillis($started_at)) / 1000, 1)) & ' s', 'Alarm to recovery:  ' & ($alarm_time = '' ? 'n/a' : $string($round(($toMillis($t_last_check) - $toMillis($alarm_time)) / 1000, 1)) & ' s'), 'Healthy targets:    ' & $string($last_check.targets), '', 'Next: investigate the old AZ, then run scripts/start_failback.sh when it is fixed.', '', 'Execution: ' & $states.context.Execution.Id, '', '--- AI incident report (Amazon Bedrock; verify against the facts above) ---', $ai_report], '\\n') %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Succeeded"
    },
    "Succeeded": {
      "Type": "Succeed"
    },
    "AnalyzeFailure": {
      "Type": "Task",
      "Comment": "Bedrock suggests a likely cause. Own Catch: on any error the plain FAILED message is still sent.",
      "Resource": "arn:aws:states:::bedrock:invokeModel",
      "TimeoutSeconds": 30,
      "Arguments": {
        "ModelId": "${bedrock_model_arn}",
        "ContentType": "application/json",
        "Accept": "application/json",
        "Body": {
          "schemaVersion": "messages-v1",
          "system": [
            {
              "text": ${failure_prompt}
            }
          ],
          "messages": [
            {
              "role": "user",
              "content": [
                {
                  "text": "{% 'Facts (JSON):\\n' & $string({'workflow': 'failover', 'result': 'FAILED', 'failed_state': $failed_state, 'error': $string($error.Error), 'cause': $substring($string($error.Cause), 0, 1500), 'trigger': $trigger, 'alarm_time_utc': $alarm_time, 'execution_started_utc': $started_at, 'precheck_utc': $t_precheck, 'precheck_result': $precheck, 'target_scaled_up_utc': $t_scale_up, 'health_checks_done': $checks, 'last_health_check': $last_check, 'source': {'asg': $cfg.source_asg, 'az': $cfg.source_az}, 'target': {'asg': $cfg.target_asg, 'az': $cfg.target_az}}) %}"
                }
              ]
            }
          ],
          "inferenceConfig": {
            "maxTokens": ${max_tokens},
            "temperature": 0.2
          }
        }
      },
      "Assign": {
        "ai_analysis": "{% $states.result.Body.output.message.content[0].text %}"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Assign": {
            "ai_analysis": "{% '(AI failure analysis unavailable: ' & $states.errorOutput.Error & '. The facts above are complete.)' %}"
          },
          "Next": "NotifyFailure"
        }
      ],
      "Next": "NotifyFailure"
    },
    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Arguments": {
        "TopicArn": "${sns_topic_arn}",
        "Subject": "[mazf] Failover FAILED",
        "Message": "{% $join(['Taskboard failover FAILED.', '', 'Failed in state: ' & $failed_state, 'Error: ' & $string($error.Error), 'Cause: ' & $string($error.Cause), '', 'Trigger:  ' & $trigger, 'Alarm:    ' & ($alarm_time = '' ? 'n/a' : $alarm_time), 'Planned:  ' & $cfg.source_asg & ' (' & $cfg.source_az & ') -> ' & $cfg.target_asg & ' (' & $cfg.target_az & ')', 'Standby scaled up at: ' & ($t_scale_up = '' ? 'not reached' : $t_scale_up), '', 'Check both ASGs, the target group health and the execution history. Traffic may be on neither AZ.', '', 'Execution: ' & $states.context.Execution.Id, '', '--- AI failure analysis (Amazon Bedrock; suggestions only) ---', $ai_analysis], '\\n') %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Failed"
    },
    "Failed": {
      "Type": "Fail",
      "Error": "{% $string($error.Error) %}",
      "Cause": "{% $string($error.Cause) %}"
    }
  }
}
