# Copy to terraform.tfvars (gitignored) and fill in real values.
aws_profile           = "your-aws-profile"
aws_region            = "us-east-1"
name_prefix           = "mazf"
owner                 = "your-name"
allowed_cidr          = "203.0.113.10/32"       # curl -s https://checkip.amazonaws.com  -> <ip>/32
artifacts_bucket_name = "mazf-artifacts-xxxxxxxx" # bootstrap output: artifacts_bucket_name
instance_type         = "t3.micro"
